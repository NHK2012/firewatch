# Copy to airflow/.env and fill in. NEVER commit airflow/.env (git-ignored by *.env).
# Docker Compose reads this file for ${...} substitution and for the containers.
AIRFLOW_UID=50000                 # on Linux use: id -u
FIREWATCH_PROJECT=                # e.g. firewatch-de-bj
AIRFLOW_VAR_FIRMS_API_KEY=        # NASA MAP_KEY
AIRFLOW_VAR_AIRBYTE_CONNECTION_ID=   # UUID from the Airbyte connection URL
AIRFLOW_VAR_AIRBYTE_CLIENT_ID=       # from: abctl local credentials
AIRFLOW_VAR_AIRBYTE_CLIENT_SECRET=
# Optional
FIRMS_PRODUCT=VIIRS_NOAA20_NRT       # must match the Airbyte source input `source`
FIREWATCH_RETRY_DELAY_MIN=5       # set to 1 for the failure/retry demo
AIRFLOW_VAR_FIREWATCH_MIN_ROWS=1000   # minimum rows per load, set from your real daily count
# AIRFLOW_JWT_SECRET=             # optional; any long random string
